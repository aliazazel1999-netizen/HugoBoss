# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAAA...
# شناسه عددی ادمین ربات (از @userinfobot بگیرید)
ADMIN_ID=123456789
# توکن محرمیت وب‌هوک (هر رشته تصادفی؛ باید با setWebhook ست شود)
WEBHOOK_SECRET=change-me-random

# --- Redis (Upstash REST) ---
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXX...

# --- Gemini ---
GEMINI_API_KEY=AIza...
# مدل پیش‌فرض (در صورت 404/429/500/503 خودکار روی مدل‌های بعدی می‌رود)
GEMINI_MODEL=gemini-3.5-flash-lite

# --- امنیت endpoint ها ---
CRON_SECRET=change-me-random

# --- تنظیمات اختیاری ---
# حداکثر پست در هر اجرا
MAX_POSTS_PER_RUN=6
# حداکثر تعداد زنجیره‌های خودفراخوان در یک دور
CHAIN_LIMIT=20
# عکس‌ها همیشه به‌صورت فایل ارسال شوند (true/false)
PHOTO_AS_DOCUMENT=false
# عکس‌های بزرگ‌تر از این حد (مگابایت) به‌صورت فایل ارسال می‌شوند تا کیفیت اصلی حفظ شود
PHOTO_MAX_MB=2
# ادامه خودکار صف پس از ۵ دقیقه استراحت (on/off)
AUTO_RESUME=on
# تأخیر ادامه خودکار به میلی‌ثانیه
AUTO_RESUME_DELAY_MS=300000
# پیش‌فرض نمایش لینک پست در کپشن (true/false) — قابل تغییر با /link
INCLUDE_POST_LINK=false
